        <mxCell id="title" value="My Secure IDE — from kit sources to a running IDE" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="0" y="18" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="sbx builds the kit image once, then every sbx run --display starts a fresh, confined IDE" style="text;html=1;align=center;fontSize=13;fontStyle=2;fontColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="0" y="48" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="b1" value="💾&lt;br&gt;&lt;b&gt;Kit sources&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:12px&apos;&gt;kit.yaml (descriptor, policy)&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:12px&apos;&gt;kit.dockerfile + bin/ + config/&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E3F2FD;gradientColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=2;shadow=1;fontSize=15;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="b2" value="🏗️&lt;br&gt;&lt;b&gt;sbx kit builder&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:12px&apos;&gt;builds the image and&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:12px&apos;&gt;embeds the kit descriptor&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFDE7;gradientColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=2;shadow=1;fontSize=15;fontColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="b3" value="📦&lt;br&gt;&lt;b&gt;Kit image&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:12px&apos;&gt;VS Code · Claude Code&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:12px&apos;&gt;network policy · agent context&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E1F5FE;gradientColor=#B3E5FC;strokeColor=#0277BD;strokeWidth=2;shadow=1;fontSize=15;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="220" height="130" as="geometry"/></mxCell>
